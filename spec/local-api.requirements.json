{
  "$comment": "What the SDK requires of the tunnel's local API, per route, in machine-readable form. tools/contract_diff.py checks a JSON-Schema export of the tunnel's zod schemas against this file (Phase 8). Field paths use dot notation; `?` marks optional fields the SDK uses when present.",
  "apiVersionMajor": 1,
  "routes": {
    "GET /v1/info": {
      "response": ["apiVersion", "legId", "peerOrgSlug", "role", "state", "direction?", "guards?", "caps?", "operations?"]
    },
    "POST /v1/request": {
      "request": ["payload", "correlationId?"],
      "response": ["correlationId"],
      "statuses": [202, 403, 409, 422, 429, 503]
    },
    "GET /v1/responses/{correlationId}": {
      "response": ["messageId", "correlationId", "payload", "budget?", "receivedAt?"],
      "statuses": [200, 204, 403, 404, 503]
    },
    "DELETE /v1/request/{correlationId}": {
      "statuses": [204, 403, 503],
      "optional": true
    },
    "GET /v1/messages/next": {
      "response": ["messageId", "correlationId", "payload", "budget?", "receivedAt?"],
      "statuses": [200, 204, 403, 503]
    },
    "POST /v1/messages": {
      "request": ["inReplyTo", "payload"],
      "response": ["messageId", "budget?"],
      "statuses": [202, 400, 403, 422, 429, 503]
    },
    "POST /v1/messages/{messageId}/ack": {
      "statuses": [204, 404]
    },
    "POST /v1/complete": {
      "statuses": [202, 403, 409, 503]
    }
  },
  "terminalBody": ["terminal", "code", "message?", "detail?"],
  "terminalCodes": ["STUDY_COMPLETE", "SESSION_ERRORED", "LIMIT_EXCEEDED"],
  "budget": ["roundsUsed", "roundsMax", "responseBytesUsed", "responseBytesMax", "queryBytesUsed", "queryBytesMax", "roundsPerHourUsed?", "roundsPerHourMax?"]
}
